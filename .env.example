# ==============================================================
#  Lyftr AI – Backend Configuration
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ==============================================================

# ── LLM Provider Keys ─────────────────────────────────────────
# Comma-separated key=value pairs.
# key_1 is tried first, key_2 is the fallback.
# OpenAI keys use sk-...; Google AI Studio Gemini keys use AIza...
# Gemini is detected by key value prefix or an id named gemini/google.
LLM_API_KEYS=

# ── LLM Model ─────────────────────────────────────────────────
# OpenAI LiteLLM model identifier
LLM_MODEL=gpt-4o-mini

# Gemini model id (without the gemini/ provider prefix)
GEMINI_MODEL=gemini-2.5-flash

# Safety ceiling for unusually long generations; not a target response length.
LLM_MAX_OUTPUT_TOKENS=2048

# ── Database ──────────────────────────────────────────────────
# SQLite file path (used as-is by sqlite3).
# In Docker this resolves to the mounted volume at /data/app.db
DATABASE_URL=sqlite:///./data/app.db

# ── Cache ─────────────────────────────────────────────────────
# Set to true to enable LiteLLM in-memory response cache.
CACHE_ENABLED=true

# ── Failure Simulation (for integration testing only) ─────────
# When set to true the X-Simulate-Failure request header is honoured.
ENABLE_FAILURE_SIMULATION=false
